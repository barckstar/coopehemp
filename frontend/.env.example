# ─── CoopeHemp Frontend — Variables de entorno ───────────────────────────────
# Copiá este archivo a .env.local y completá los valores reales.
# NUNCA commitees .env.local ni ningún archivo con valores reales.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Medusa Backend ───────────────────────────────────────────────────────────
# Local dev:
VITE_MEDUSA_URL=http://localhost:9000
# Producción (Vercel / Railway / etc.):
# VITE_MEDUSA_URL=https://api.coopehemp.cr

# ─── Publishable API Key ──────────────────────────────────────────────────────
# Obtener ejecutando en el directorio Back-End:
#   npx medusa exec ./src/scripts/create-publishable-key.ts
VITE_MEDUSA_PUBLISHABLE_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Pasarela de pago (agregar cuando esté definida) ─────────────────────────
# Stripe
# VITE_STRIPE_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxx
# (desarrollo)
# VITE_STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx

# PayPal
# VITE_PAYPAL_CLIENT_ID=Axxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
