{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": false,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@medusajs/framework/http": ["./node_modules/@medusajs/framework/dist/http/index.d.ts"],
      "@medusajs/framework/utils": ["./node_modules/@medusajs/framework/dist/utils/index.d.ts"],
      "@medusajs/framework/types": ["./node_modules/@medusajs/framework/dist/types/index.d.ts"],
      "@medusajs/framework/mikro-orm/migrations": ["./node_modules/@medusajs/framework/dist/deps/mikro-orm-migrations.d.ts"]
    }
  },
  "ts-node": {
    "transpileOnly": true,
    "files": true
  },
  "include": ["src"],
  "exclude": ["node_modules", ".medusa"]
}
