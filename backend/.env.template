# ══════════════════════════════════════════════════════════════════════════════
#  CoopeHemp Back-End — Variables de entorno
#  Copia este archivo a .env y rellena los valores reales.
#  NUNCA subas .env al repositorio.
#
#  Generar secretos seguros:
#    openssl rand -hex 32
# ══════════════════════════════════════════════════════════════════════════════

# ─── Base de datos (PostgreSQL) ───────────────────────────────────────────────
POSTGRES_USER=coopehemp
POSTGRES_PASSWORD=           # openssl rand -hex 16
POSTGRES_DB=coopehemp_db
DATABASE_URL=postgres://coopehemp:TU_PASSWORD@localhost:5432/coopehemp_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Medusa — Secrets (OBLIGATORIO cambiar en producción) ────────────────────
JWT_SECRET=           # openssl rand -hex 32
COOKIE_SECRET=        # openssl rand -hex 32

# ─── Medusa — URLs y CORS ─────────────────────────────────────────────────────
MEDUSA_BACKEND_URL=http://localhost:9000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000,http://localhost:5173
STORE_CORS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ─── Email / SMTP ─────────────────────────────────────────────────────────────
# Desarrollo → Mailpit (Docker: SMTP localhost:1025 | UI: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@coopehemp.cr

# Producción → Resend
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxx
# SMTP_FROM=noreply@coopehemp.cr

# ─── Pasarela de pago (descomentar cuando esté lista) ────────────────────────
# ── Stripe ───────────────────────────────────────────────────────────────────
# npm install @medusajs/payment-stripe  →  agregar módulo en medusa-config.ts
# STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
# (pruebas)
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

